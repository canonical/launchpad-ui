{
  "name": "launchpad-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint . && pnpm run lint:css",
    "lint:fix": "pnpm run format && eslint . --fix && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.{css,svelte}\" \".storybook/**/*.{css,svelte}\"",
    "check": "pnpm run check:svelte && pnpm run lint",
    "check:fix": "pnpm run check:svelte && pnpm run lint:fix",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:svelte:watch": "pnpm run check:svelte -- --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:server": "pnpm run test --project=server",
    "test:client": "pnpm run test --project=client",
    "test:client:chromium": "pnpm run test --project=client --browser=chromium",
    "test:client:firefox": "pnpm run test --project=client --browser=firefox",
    "test:client:webkit": "pnpm run test --project=client --browser=webkit",
    "test:watch:client": "pnpm run test:watch --project=client --browser.headless=false",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@canonical/launchpad-design-tokens": "^1.1.1",
    "@canonical/svelte-ssr-test": "^0.25.0",
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@standard-schema/spec": "^1.1.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/sveltekit": "^10.6.5",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^25.9.9",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "playwright": "^1.64.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "storybook": "^10.6.5",
    "stylelint": "^18.0.0",
    "stylelint-config-html": "^2.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vitest-browser-svelte": "^3.1.0"
  },
  "dependencies": {
    "@canonical/launchpad-client": "^0.0.1",
    "@canonical/styles": "^0.44.0",
    "@canonical/superhref": "^0.1.0",
    "@canonical/svelte-ds-app": "^0.44.0",
    "@canonical/svelte-ds-app-launchpad": "^0.44.1",
    "@canonical/svelte-icons": "^0.0.9",
    "@floating-ui/dom": "^1.7.6",
    "markdown-actions": "^1.2.0",
    "undici": "^8.5.0",
    "valibot": "^1.4.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
